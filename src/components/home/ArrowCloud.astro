---

---
<section class="arrow-cloud">
    <div class="arrow-cloud__canvas" data-arrow-cloud></div>
</section>
<script>
    import { animationSettings, arrowPaths, cameraTrack } from "../../arrowData.js";

    function importRuntimeModule(runtimePath: string) {
        return new Function(
            'runtimePath',
            'return import(runtimePath);'
        )(runtimePath);
    }
    
    const mountElement = document.querySelector('[data-arrow-cloud]');
    const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
    ).matches;

    const urlSearchParams = new URLSearchParams(window.location.search);

    const shouldUseLabsRuntime = import.meta.env.DEV
        && urlSearchParams.has('arrow-labs');

    const runtimePath = shouldUseLabsRuntime
        ? '/assets/arrow-cloud/arrow-cloud-labs-runtime.js'
        : '/assets/arrow-cloud/arrow-cloud-runtime.js';

    if (mountElement && !prefersReducedMotion) {
        const runtimeModule = await importRuntimeModule(runtimePath);
        const { createArrowCloudScene } = runtimeModule;

        const arrowCloudScene = createArrowCloudScene(mountElement, {
            animationSettings: {
                ...animationSettings,
                debugMode: shouldUseLabsRuntime
            },
            arrowPaths,
            cameraTrack
        });

        document.addEventListener('astro:before-swap', () => {
            arrowCloudScene.destroy();
        }, { once: true});
    }
</script>
<style>
    .arrow-cloud {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
    }

    .arrow-cloud__canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .arrow-cloud__canvas canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>