---
import '../styles/main.css';
import { getCollection } from 'astro:content'

import Hero from "../components/home/Hero.astro";
import Intro from "../components/home/Intro.astro"
import Services from "../components/home/Services.astro";
import SelectedProjectStories from "../components/home/SelectedProjectStories.astro";
import MoreShippedWork from "../components/home/MoreShippedWork.astro";

const homepageEntries = await getCollection('homepage');

console.log('Homepage entries:', homepageEntries.length);

console.table(
    homepageEntries.map(entry => ({
        id: entry.id,
        section: entry.data.section
    }))
);

const homepageSections = Object.fromEntries(
    homepageEntries.map((entry) => {
        return [entry.data.section, entry];
    })
);

const hero = homepageSections.hero;
const intro = homepageSections.intro;
const services = homepageSections.services;
const projectStories = homepageSections['selected-project-stories'];
const moreShippedWork = homepageSections['more-shipped-work'];

const requiredSections = [
    'hero',
    'intro',
    'services',
    'selected-project-stories',
    'more-shipped-work'
];

const missingSections = requiredSections.filter(
    section => !homepageSections[section]
);

if (missingSections.length > 0) {
    throw new Error(
        `Missing homepage sections: ${missingSections.join(', ')}`
    );
}
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Adam Trickett</title>
	</head>
	<body>
        <main>
            <Hero entry={hero} />
            <Intro entry={intro} />
            <Services entry={services} />
            <SelectedProjectStories entry={projectStories} />
            <MoreShippedWork entry={moreShippedWork} />
        </main>
	</body>
</html>

